<?xml version="1.0" encoding="utf-8"?>
<!-- SCREEN 8: Projects Screen -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- TOP TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_purple_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_logo_mark"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Algorithmics"
                android:textColor="@color/white"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/img_game_placeholder" android:contentDescription="icon"
            android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_circle_icon2" android:contentDescription="icon"
            android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_circle_icon3" android:contentDescription="icon" />
    </LinearLayout>

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/toolbar_height"
        android:layout_marginBottom="@dimen/bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_md">

            <!-- Projects Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Projects"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/margin_md" />

            <!-- Projects Grid (2 columns, 4 rows = 8 items like in design) -->
            <GridLayout
                android:id="@+id/grid_projects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

            </GridLayout>

            <!-- Pink progress bar at bottom (as seen in design) -->
            <ProgressBar
                android:id="@+id/pb_projects"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="60"
                android:progressTint="@color/pink_accent"
                android:progressBackgroundTint="@color/progress_bar_bg"
                android:layout_marginTop="@dimen/margin_md" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
