<?xml version="1.0" encoding="utf-8"?>
<!-- TEACHER SCREEN 6: Students List screen -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- TOP TOOLBAR (purple) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/purple_primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <!-- Screen title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Login Menu"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_toolbar_icon1" android:contentDescription="icon"
            android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_hamburger_white" android:contentDescription="Menu" />
    </LinearLayout>

    <!-- CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:orientation="vertical">

        <!-- Students section header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/white"
            android:elevation="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Students:"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Search or filter icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search students" />
        </LinearLayout>

        <!-- Group filter dropdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@color/white">

            <Spinner
                android:id="@+id/spinner_student_group"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="8dp"
                android:minWidth="100dp"
                android:layout_marginEnd="8dp" />

            <!-- Lesson filter -->
            <Spinner
                android:id="@+id/spinner_student_lesson"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- Student list RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_students"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
