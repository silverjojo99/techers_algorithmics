<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable: Detail info row in Teacher Dashboard -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="6dp">

    <!-- Row label -->
    <TextView
        android:id="@+id/tv_detail_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lesson info / applications"
        android:textColor="@color/text_dark"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Sub-values row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_detail_val1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="option 1"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tv_detail_val2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="option 2"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Progress indicator bar -->
    <ProgressBar
        android:id="@+id/pb_detail"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progress="55"
        android:progressTint="@color/purple_light"
        android:progressBackgroundTint="@color/progress_bar_bg"
        android:layout_marginTop="4dp" />

</LinearLayout>
