<?xml version="1.0" encoding="utf-8"?>
<!-- SCREEN 2: Main Dashboard (Home) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- TOP TOOLBAR -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:elevation="4dp">

        <!-- Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_purple_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_logo_mark"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Algorithmics"
                android:textColor="@color/white"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Icon buttons -->
        <ImageView
            android:id="@+id/iv_icon1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/img_game_placeholder"
            android:contentDescription="icon"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/iv_icon2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_circle_icon2"
            android:contentDescription="icon"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/iv_icon3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_circle_icon3"
            android:contentDescription="icon" />
    </LinearLayout>

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/toolbar_height"
        android:layout_marginBottom="@dimen/bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_md">

            <!-- User Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_md">

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:src="@drawable/ic_avatar_placeholder"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="User avatar" />

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ahmed-ahmed"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp" />

                <ImageView
                    android:id="@+id/iv_hamburger"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_menu_hamburger"
                    android:contentDescription="Menu" />
            </LinearLayout>

            <!-- NEXT LESSON Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT LESSON"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/margin_sm" />

            <include
                layout="@layout/item_lesson_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- UNIT/LESSON label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNIT / LESSON"
                android:textColor="@color/text_gray"
                android:textSize="@dimen/text_xs"
                android:layout_marginTop="@dimen/margin_md"
                android:layout_marginBottom="@dimen/margin_sm" />

            <!-- Course Cards List -->
            <include
                layout="@layout/item_lesson_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <include
                layout="@layout/item_lesson_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <include
                layout="@layout/item_lesson_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Goals and Achievements -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goals and achievements"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_md"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/margin_md"
                android:layout_marginBottom="@dimen/margin_sm" />

            <include
                layout="@layout/item_goals_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
