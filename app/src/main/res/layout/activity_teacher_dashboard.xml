<?xml version="1.0" encoding="utf-8"?>
<!-- TEACHER SCREEN 3: Login with floating input state (fields appear above keyboard) -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Same login layout, reused -->
    <include layout="@layout/activity_teacher_login" />

    <!-- Floating input overlay (shown when field is focused above the fold) -->
    <LinearLayout
        android:id="@+id/layout_floating_inputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="32dp">

        <!-- Floating email field at top -->
        <EditText
            android:id="@+id/et_floating_email"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="14dp"
            android:hint="admin@algorithmics.email"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <!-- Floating password row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/et_floating_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_input_password"
                android:paddingHorizontal="14dp"
                android:paddingEnd="44dp"
                android:hint="••••••••••"
                android:textSize="12sp"
                android:inputType="textPassword"
                android:singleLine="true" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_eye"
                android:contentDescription="Show" />
        </RelativeLayout>

        <!-- Floating visible password -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/et_floating_password2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_input_password"
                android:paddingHorizontal="14dp"
                android:paddingEnd="44dp"
                android:text="ahmed234"
                android:textSize="12sp"
                android:inputType="text"
                android:singleLine="true" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_eye_off"
                android:contentDescription="Hide" />
        </RelativeLayout>

        <!-- Login button -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Login"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_purple" />

    </LinearLayout>
</FrameLayout>
