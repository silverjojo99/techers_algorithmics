<?xml version="1.0" encoding="utf-8"?>
<!-- SCREEN 3 & 4: Slide-out Menu Drawer (two states: partial and full) -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content behind drawer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light">

        <include layout="@layout/activity_main_dashboard" />
    </FrameLayout>

    <!-- Drawer Menu Panel -->
    <LinearLayout
        android:id="@+id/nav_drawer_panel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/purple_menu"
        android:elevation="8dp">

        <!-- Drawer Header - user info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/margin_md"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="@dimen/margin_md">

            <ImageView
                android:id="@+id/drawer_avatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:src="@drawable/ic_avatar_placeholder"
                android:background="@drawable/bg_avatar_circle_white"
                android:contentDescription="User avatar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ahmed ahmed"
                android:textColor="@color/white"
                android:textSize="@dimen/text_md"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/margin_sm" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFFFFF33"
            android:layout_marginHorizontal="@dimen/margin_md" />

        <!-- Menu: Main -->
        <TextView
            android:id="@+id/menu_item_main"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:text="Main"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margin_lg"
            android:background="@drawable/bg_menu_item_selected" />

        <!-- Menu: Course -->
        <TextView
            android:id="@+id/menu_item_course"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:text="Course"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margin_lg"
            android:background="@drawable/bg_menu_item_normal" />

        <!-- Menu: Online lesson -->
        <TextView
            android:id="@+id/menu_item_online"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:text="Online lesson"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margin_lg"
            android:background="@drawable/bg_menu_item_normal" />

        <!-- Menu: community -->
        <TextView
            android:id="@+id/menu_item_community"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:text="community"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margin_lg"
            android:background="@drawable/bg_menu_item_normal" />

        <!-- Menu: laboratory -->
        <TextView
            android:id="@+id/menu_item_laboratory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_item_height"
            android:text="laboratory"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margin_lg"
            android:background="@drawable/bg_menu_item_normal" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
