<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable: Student row in the students list (Screen 6) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_white"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <!-- Student Avatar -->
    <ImageView
        android:id="@+id/iv_row_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:background="@drawable/bg_avatar_circle"
        android:contentDescription="Avatar"
        android:layout_marginEnd="12dp" />

    <!-- Name + subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_row_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ahmed ahmed"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_row_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Group · Python"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Status chip -->
    <TextView
        android:id="@+id/tv_row_status"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="Active"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:background="@drawable/bg_badge_green"
        android:layout_marginEnd="8dp" />

    <!-- Arrow -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_arrow_right"
        android:contentDescription="View student" />

</LinearLayout>
