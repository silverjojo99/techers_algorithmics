<?xml version="1.0" encoding="utf-8"?>
<!-- SCREEN 7: Trends Screen -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- TOP TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_purple_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_logo_mark"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Algorithmics"
                android:textColor="@color/white"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/img_python_thumb" android:contentDescription="icon"
            android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_circle_icon2" android:contentDescription="icon"
            android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_circle_icon3" android:contentDescription="icon" />
    </LinearLayout>

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/toolbar_height"
        android:layout_marginBottom="@dimen/bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_md">

            <!-- Trends Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trends"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/margin_md" />

            <!-- Game Grid (2 columns) -->
            <GridLayout
                android:id="@+id/grid_trends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:useDefaultMargins="true">

                <!-- Game 1 -->
                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <!-- Game 2 -->
                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <!-- Game 3 -->
                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <!-- Game 4 -->
                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <!-- Game 5 -->
                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

                <!-- Game 6 -->
                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />

            </GridLayout>

            <!-- Progress Bars Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin_md">

                <!-- Bar 1 -->
                <ProgressBar
                    android:id="@+id/pb_trend1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progress="70"
                    android:progressTint="@color/trends_bar_1"
                    android:progressBackgroundTint="@color/progress_bar_bg"
                    android:layout_marginBottom="@dimen/margin_sm" />

                <!-- Bar 2 -->
                <ProgressBar
                    android:id="@+id/pb_trend2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progress="50"
                    android:progressTint="@color/trends_bar_2"
                    android:progressBackgroundTint="@color/progress_bar_bg"
                    android:layout_marginBottom="@dimen/margin_sm" />

                <!-- Bar 3 -->
                <ProgressBar
                    android:id="@+id/pb_trend3"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progress="85"
                    android:progressTint="@color/pink_accent"
                    android:progressBackgroundTint="@color/progress_bar_bg" />

            </LinearLayout>

            <!-- Bottom row: Game 7 + 8 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/margin_md">

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_xs" />

                <include layout="@layout/item_game_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_xs" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
