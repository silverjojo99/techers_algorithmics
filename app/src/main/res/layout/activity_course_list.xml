<?xml version="1.0" encoding="utf-8"?>
<!-- SCREEN 5 & 6: Course List (scrollable lesson rows) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- TOP TOOLBAR (same as dashboard) -->
    <LinearLayout
        android:id="@+id/toolbar_course"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_purple_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_logo_mark"
                android:contentDescription="@string/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/algorithmics"
                android:textColor="@color/white"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/icon1"
            android:contentDescription="@string/icon1"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/icon2"
            android:contentDescription="@string/icon2"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/icon3"
            android:contentDescription="@string/icon3" />
    </LinearLayout>

    <!-- Scrollable lesson list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_course_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/toolbar_height"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        android:padding="@dimen/margin_sm"
        android:clipToPadding="false" />

    <!-- BOTTOM NAV -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
