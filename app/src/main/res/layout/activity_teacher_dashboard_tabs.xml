<?xml version="1.0" encoding="utf-8"?>
<!-- TEACHER SCREEN 5: Dashboard with "by Group / by Lessons / by Students" tab active -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- TOP TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/purple_primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_purple_dark_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_logo_mark_white"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Algorithmics"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_toolbar_icon1" android:contentDescription="icon"
            android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_toolbar_icon2" android:contentDescription="icon"
            android:layout_marginEnd="8dp" />
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_hamburger_white" android:contentDescription="Menu" />
    </LinearLayout>

    <!-- CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:orientation="vertical">

        <!-- Filter Tabs Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/white"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tab_all2"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="All"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_tab_inactive"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tab_by_group2"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="by Group"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_tab_active"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tab_by_lessons2"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="by Lessons"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_tab_inactive"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tab_by_students2"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="by Students"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_tab_inactive" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Group dropdown filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Group:"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spinner_group"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="8dp" />

        </LinearLayout>

        <!-- Scrollable content area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- "show your stats" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="show your stats"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Details Card with progress % -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="12dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Details:"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▲ 39%"
                            android:textColor="@color/green_badge"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <include layout="@layout/item_teacher_detail_row" />
                    <include layout="@layout/item_teacher_detail_row" />
                    <include layout="@layout/item_teacher_detail_row" />
                    <include layout="@layout/item_teacher_detail_row" />

                    <!-- Lazy Tuesday label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lazy Tuesday"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp" />

                    <include layout="@layout/item_teacher_detail_row" />

                    <!-- Lesson notes button -->
                    <Button
                        android:id="@+id/btn_lesson_notes"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="lesson notes"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:background="@drawable/bg_btn_purple_small"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
